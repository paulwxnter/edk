{
	"$schema": "./node_modules/wrangler/config-schema.json",
	"name": "edk",
	"main": "./workers/app.ts",
	"compatibility_date": "2025-10-08",
	"compatibility_flags": ["nodejs_compat"],
	"observability": {
		"enabled": true
	},
	"upload_source_maps": true,
	"workers_dev": true,
	"routes": [
		{ "pattern": "edk.earth", "custom_domain": true },
		{ "pattern": "www.edk.earth", "custom_domain": true },
		{ "pattern": "api.edk.earth", "custom_domain": true },
		{ "pattern": "cdn.edk.earth", "custom_domain": true },
		{ "pattern": "embed.edk.earth", "custom_domain": true }
	],
	"d1_databases": [
		{
			"binding": "DB",
			"database_name": "edk-db",
			"database_id": "723a1977-5f8f-4354-a337-ffcdfba996e2",
			"migrations_dir": "migrations"
		}
	],
	"ratelimits": [
		{ "name": "RL_API_COMMUNITY", "namespace_id": "1001", "simple": { "limit": 60, "period": 60 } },
		{ "name": "RL_API_TIER1", "namespace_id": "1002", "simple": { "limit": 120, "period": 60 } },
		{ "name": "RL_API_TIER2", "namespace_id": "1003", "simple": { "limit": 300, "period": 60 } },
		{ "name": "RL_API_TIER3", "namespace_id": "1004", "simple": { "limit": 600, "period": 60 } },
		{ "name": "RL_API_TIER4", "namespace_id": "1005", "simple": { "limit": 1200, "period": 60 } },
		{ "name": "RL_API_TIER5", "namespace_id": "1006", "simple": { "limit": 3000, "period": 60 } },
		{ "name": "RL_AUTH", "namespace_id": "1010", "simple": { "limit": 10, "period": 60 } }
	],
	"triggers": {
		"crons": ["*/5 * * * *"]
	},
	"send_email": [
		{
			"name": "EMAIL",
			"allowed_sender_addresses": ["hello@edk.earth"]
		}
	],
	"vars": {
		"SITE_URL": "https://edk.earth",
		"API_URL": "https://api.edk.earth",
		"CDN_URL": "https://cdn.edk.earth",
		"EMBED_URL": "https://embed.edk.earth",
		"STRIPE_MODE": "test",
		"DISCOVER_SPATIAL": "1",
		"EMAIL_FROM": "hello@edk.earth",
		"REQUIRE_EMAIL_VERIFICATION": "true"
	}
}
